# Generated outputs
output/
datasets/
runs/
*.hdf5

# Large generated binaries in data/assets (keep part.json metadata)
data/assets/**/*.ply
data/assets/**/*.obj
data/assets/**/*.stl
data/assets/**/*.glb
data/assets/**/*.png
!data/assets/**/part.json

# Model weights
*.pt
*.onnx

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated rest poses (regenerate with screwsynth-restposes compute --all)
data/rest_poses/*.json
data/rest_poses/*.png

# NiceGUI local storage (GUI remembers the last recipe)
.nicegui/

# your surface photos for backgrounds (backgrounds.yaml, the list, stays tracked)
data/plate/*.png
data/plate/*.jpg
data/plate/*.jpeg
data/plate/*.tif
data/plate/*.tiff
data/plate/*.webp
